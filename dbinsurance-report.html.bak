        <span style="font-size:13px;color:var(--text-secondary);">최종 업데이트: <strong style="color:var(--text-light);">2026년 04월 08일 06:00 KST</strong></span>
        <span style="margin-left:auto;font-size:11px;color:var(--text-muted);">FLOVAH Auto-Monitor</span>
    </div>
</div>
<!-- /LAST-UPDATE-BLOCK -->
